# Copy to .env next to server.js for local runs. On the VPS the same settings live
# in the systemd service (deploy/setup-vps.sh), on Render — in Environment.

# Local server
PORT=3457
# Public address used in Telegram links, e.g. https://turontz.space
PUBLIC_URL=

# AI: auto = local Ollama when available, otherwise the built-in parser.
# For a hosted service without an external AI key use offline.
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional Claude connection. Leave blank if you use the free local AI.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Telegram bot token. Usually set from the app (Команда → Telegram-бот) instead.
# TELEGRAM_BOT_TOKEN=

# Limits and schedules
MAX_UPLOAD_MB=300        # largest file one upload may be (Caddy allows 320MB)
TOKEN_TTL_DAYS=30        # a session unused this long signs out
BACKUP_HOUR=21           # daily database backup to Telegram, Tashkent time
LOW_DISK_GB=2            # warn managers when free disk space drops below this

# Set to 1 only behind a hosting proxy that sets X-Forwarded-For (Render).
TRUST_PROXY=

# Optional Supabase persistence and private file storage.
# Keep the service-role key ONLY on the server / in Render environment variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=turon_tz_state
SUPABASE_STORAGE_BUCKET=turon-tz-files
SUPABASE_MAX_FILE_MB=8
